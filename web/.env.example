# Copia a .env.local para desarrollo. NUNCA subas valores reales a GitHub.
# URL pública exacta del despliegue (sin barra final). Debe coincidir con el redirect de Discord.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Discord Developer Portal -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Secreto aleatorio de 32+ caracteres para firmar la cookie de sesión (solo servidor).
SESSION_SECRET=

# Supabase (solo servidor — nunca exponer la service role al cliente).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
