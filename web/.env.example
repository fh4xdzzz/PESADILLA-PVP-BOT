# Copiar a .env.local. NUNCA subir secretos a GitHub.
# URL pública del despliegue sin barra final. Debe coincidir con el redirect de Discord.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Discord Developer Portal > OAuth2: scope identify guilds
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 32 o más caracteres aleatorios; firma cookies y deriva la clave de cifrado OAuth.
# Cambiarlo invalida cookies y requiere nueva autorización de Discord.
SESSION_SECRET=

# Supabase (SOLO SERVIDOR)
SUPABASE_URL=
# Obligatorio para guardar tokens cifrados y configuración por servidor.
# Nunca exponer en componentes cliente o variables NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Compatibilidad con implementaciones antiguas; no habilita administración del panel.
SUPABASE_PUBLISHABLE_KEY=

# Token compartido SOLO entre Vercel y el bot de Sparked Host (32+ caracteres aleatorios).
# Debe ser distinto de DISCORD_BOT_TOKEN y de SUPABASE_SERVICE_ROLE_KEY.
BOT_SYNC_TOKEN=
