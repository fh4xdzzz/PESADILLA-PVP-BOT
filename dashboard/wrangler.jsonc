{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pesadilla-pvp-dashboard",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "keep_vars": true,
  // Crear la base de datos con: npx wrangler d1 create pesadilla-pvp-dashboard
  // Después agregar el binding D1:
  // "d1_databases": [{ "binding":"DB", "database_name":"pesadilla-pvp-dashboard", "database_id":"TU_DATABASE_ID" }]
  "vars": {
    "APP_NAME": "PESADILLA PVP"
  }
}
