# ============================================================
# PESADILLA PVP BOT - configuracion de entorno
# Copia este archivo como .env y completa los valores.
# NUNCA subas el .env real a git ni lo compartas.
# ============================================================

# ---------- Discord ----------
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# ID del servidor de SOPORTE (tickets). Comandos guild se registran aqui al instante.
SUPPORT_GUILD_ID=
# ID del servidor PRINCIPAL (comunidad). Opcional pero recomendado.
MAIN_GUILD_ID=
# IDs de roles/usuarios de Discord con cada nivel de staff (separados por coma).
# Se usan IDs, nunca nombres de rol.
OWNER_IDS=
ADMIN_IDS=
HEAD_MOD_IDS=
MOD_IDS=
SUPPORT_STAFF_IDS=
EVENT_MANAGER_IDS=

# ---------- Roblox Open Cloud ----------
# https://create.roblox.com/dashboard/credentials
# La API key necesita estos scopes:
#   universe.user-restriction:read / :write   (baneos)
#   universe.datastore:read / :write          (estadisticas, si aplica)
ROBLOX_API_KEY=
ROBLOX_UNIVERSE_ID=
# ID numerico del place (opcional, para restricciones a nivel de place)
ROBLOX_PLACE_ID=

# ---------- Base de datos ----------
# sqlite (dev/local) | postgres (produccion)
DATABASE_URL="file:./pesadilla.db"
# Ejemplo postgres: "postgresql://user:pass@host:5432/pesadilla?schema=public"

# ---------- Bot ----------
NODE_ENV=development
LOG_LEVEL=info
# URL publica del bot si expones endpoints HTTP (opcional)
BOT_PUBLIC_URL=
# Secreto para firmar tokens de vinculacion Discord<->Roblox
LINK_SECRET=
