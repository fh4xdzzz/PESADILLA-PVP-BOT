# === Discord ===
DISCORD_TOKEN=tu_token_del_bot
DISCORD_CLIENT_ID=id_de_la_aplicacion
# ID del servidor (guild) para registrar comandos al instante. Si lo dejas vacío se registran globalmente (tardan ~1h).
DISCORD_GUILD_ID=
# IDs de usuarios de Discord permitidos a usar comandos de admin (separados por coma)
ADMIN_USER_IDS=

# === SparkedHost / Apollo Panel ===
# Panel: https://control.sparkedhost.us  ->  API Credentials  ->  Create API Key
SPARKEDHOST_API_KEY=tu_api_key
# ID del servidor (UUID o identifier corto, se ve en la URL del panel)
SPARKEDHOST_SERVER_ID=

# === Roblox Open Cloud (opcional) ===
# API key creada en https://create.roblox.com/dashboard/credentials con scope de la universe
ROBLOX_API_KEY=
ROBLOX_UNIVERSE_ID=
